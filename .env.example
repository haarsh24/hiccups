# GEMINI_API_KEY: Optional API key for Gemini API features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted
# Used for self-referential links and public endpoints
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Base URL of the standalone Hiccup backend server.
# Set this when the React frontend is deployed on Vercel or static CDN while the backend runs on Fly.io, Railway, Render, or Cloud Run.
# Example: VITE_API_BASE_URL="https://hiccups-backend.onrender.com"
VITE_API_BASE_URL=
